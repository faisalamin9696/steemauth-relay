# Template for .env — copy to .env and fill in.
#   cp .env.example .env
# .env itself is git-ignored; this template is committed.

# HTTP + WebSocket listen port (default: 8787)
PORT=8787

# Durable store: memory (default, volatile) | sqlite (survives restarts).
# STORE=sqlite requires Node >= 22 (node:sqlite).
STORE=memory
# sqlite file path (default ./relay.db when STORE=sqlite)
RELAY_DB=./relay.db

# Optional Origin allowlist for the WebSocket upgrade (comma-separated).
# Empty = open relay (safe: unguessable rooms + hashed tokens + ciphertext).
ALLOWED_ORIGINS=

# Optional limit overrides (see DEFAULTS in server.js):
# MAX_ROOMS=100000
# ROOM_IDLE_MS=900000
# MESSAGES_PER_SECOND=20
